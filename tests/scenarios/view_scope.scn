midi 80 45 0
wait 100
expect scope_note 81
expect scope_period 501
# C#3 (49), 318.4 samples, wobbling 10 cents down and back (320 is where the ring's points change from
# means of 2 to 3): the points keep their size, and a trace never mixes two (the wave itself, sliding,
# differs a little from period to period)
midi 80 51 0
midi 90 31 64
wait 300
expect scope_cycle <10
midi E0 66 3C
wait 25
expect scope_cycle <20
midi E0 00 40
wait 25
expect scope_cycle <20
midi E0 66 3C
wait 25
expect scope_cycle <20
midi E0 00 40
wait 25
expect scope_cycle <20
midi E0 66 3C
wait 25
expect scope_cycle <20
midi E0 00 40
wait 25
expect scope_cycle <20
midi E0 66 3C
wait 25
expect scope_cycle <20
midi E0 00 40
wait 25
expect scope_cycle <20
midi E0 66 3C
wait 25
expect scope_cycle <20
midi E0 00 40
wait 25
expect scope_cycle <20
midi E0 66 3C
wait 25
expect scope_cycle <20
midi E0 00 40
wait 25
expect scope_cycle <20
midi E0 66 3C
wait 100
expect scope_period >3195
midi E0 00 40
wait 100
expect scope_period 3184
# its size is the sound's, not MASTER's: the same at the bottom of the pot, and at 0
expect scope_height >40
master 4
wait 300
expect scope_period 3184
expect scope_height >40
master 0
wait 300
expect scope_height >40
master 2048
midi 80 31 0
midi 90 45 64
# FM
spin ALGO 1
expect title FM
wait 300
expect scope_period 1003
expect scope_still <10
scopemark
wait 2000
expect scope_since <15
expect scope_label Index_40
expect stale 0
# 6-op (its patch's envelopes move its wave on over seconds)
spin ALGO 1
expect title 6-op
wait 300
expect scope_period 1003
expect scope_still <10
expect scope_label Bright_40
expect stale 0
# Formant
spin ALGO 1
expect title Formant
wait 300
expect scope_period 1003
expect scope_still <10
scopemark
wait 2000
expect scope_since <15
expect stale 0
# Waveshape
spin ALGO 1
expect title Waveshape
wait 300
expect scope_period 1003
expect scope_still <10
scopemark
wait 2000
expect scope_since <15
expect stale 0
# VA (its two oscillators, detuned, beat: its two periods differ, and its wave changes as they do)
spin ALGO 1
expect title VA
wait 300
expect scope_period 1003
expect scope_label Square_40
expect stale 0
shot scope_va_light.png
# PD
spin ALGO 1
expect title PD
wait 300
expect scope_period 1003
expect scope_still <10
scopemark
wait 2000
expect scope_since <15
expect stale 0
# Harmonic
spin ALGO 1
expect title Harmonic
wait 300
expect scope_period 1003
expect scope_still <10
scopemark
wait 2000
expect scope_since <15
expect stale 0
# back to VA, F4 (65), 126.4 samples
spin ALGO -1
spin ALGO -1
expect title VA
midi 80 45 0
midi 90 41 64
wait 300
expect scope_period 1264
expect scope_note 65
# Dark
tap GLO
spin K4 1
expect par29 1
tap HOME
tap HOME
expect view 1
wait 1500
expect stale 0
shot scope_va_dark.png
# quiet again: the flat line, no period, nothing redrawn
midi 80 41 0
breath 100 0 20
wait 1500
expect scope_period 0
expect scope_trail 0
expect stale 0
shot scope_quiet_dark.png
expect blits >-1
wait 1000
expect blits 0
