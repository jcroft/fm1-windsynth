# Stage (PLAY): twelve knobs in three rows over the controllers. K1-K4 turn the lit row, SELECT moves the
# row round (saved, global), PLAY again goes back to the page it came from, a page button or EDIT leaves
# for that page. On Stage the keys light dim from the left as a breath meter.
wait 200
tap ENV
expect view 5
tap PLAY
wait 100
expect stage 1
expect title Stage
expect knob2 Cutoff
expect dimkeys 0
expect stale 0
shot stage_filter.png
# row 1 (Filter): K2 is Cutoff, lit while it turns
spin K2 5
expect par0 20
wait 20
expect acc68_141 1
wait 1500
expect acc68_141 0
# SELECT: the Engine row (Classic: no Ratio or Index), K3 is Morph
turn SELECT 1
wait 100
expect par68 1
expect title Stage
expect knob1 -
expect knob3 Morph
spin K3 5
expect par2 30
# FM: Morph is Feedback; 6-op: Ratio is the patch, and K1 turns it
spin ALGO 1
wait 100
expect knob3 Feedback
expect stale 0
spin ALGO 1
wait 100
expect knob1 Patch
spin K1 1
expect par47 95
wait 100
expect stale 0
spin K1 -1
spin ALGO -1
wait 100
spin ALGO -1
wait 100
# the FX row: K2 is Modulation's Mix
turn SELECT 1
wait 100
expect par68 2
spin K2 5
expect par53 5
wait 100
expect stale 0
shot stage_fx.png
# SELECT goes round, both ways
turn SELECT 1
wait 100
expect par68 0
turn SELECT -1
wait 100
expect par68 2
# the row isn't part of a preset: another preset keeps it
spin PRESET 1
wait 100
expect preset 2
expect par68 2
spin PRESET -1
wait 100
# the key lights: breath from the left, the sounding note's key lit on top; the ghosts are the lit row's
midi 90 3C 64
breath 0 64 60
wait 300
expect dimkeys 13
expect litkeys 128
expect ghost2 -1
turn SELECT 1
wait 100
expect par68 0
expect ghost2 >0
breath 64 127 60
wait 300
expect dimkeys 26
leds
expect stale 0
shot stage_play.png
breath 127 0 60
wait 300
expect dimkeys 0
midi 80 3C 00
wait 2500
expect stale 0
# PLAY: back to Breath, and the keys light as before
tap PLAY
wait 100
expect stage 0
expect view 5
expect dimkeys 0
expect stale 0
# a page with a second page comes back to the one it was on; EDIT leaves too
tap LFO
expect view 6
tap PLAY
tap LFO
wait 100
expect stage 0
expect view 6
tap PLAY
tap EDIT
wait 100
expect stage 0
expect view 6
# a page button leaves Stage for that page
tap PLAY
tap SEQ
wait 100
expect stage 0
expect view 12
expect stale 0
# Dark, and a long engine's name in the header
tap GLO
spin K4 1
tap PLAY
spin ALGO 1
wait 60
spin ALGO 1
wait 60
spin ALGO 1
wait 60
spin ALGO 1
wait 60
spin ALGO 1
wait 60
spin ALGO 1
wait 60
spin ALGO 1
wait 60
expect title Stage
expect stale 0
turn SELECT 1
wait 2000
expect title Stage
expect stale 0
shot stage_dark.png
turn SELECT -1
wait 100
spin ALGO -1
wait 60
spin ALGO -1
wait 60
spin ALGO -1
wait 60
spin ALGO -1
wait 60
spin ALGO -1
wait 60
spin ALGO -1
wait 60
spin ALGO -1
wait 60
# the row is kept over a reboot
tap PLAY
wait 4500
expect dirty 0
reboot
wait 200
tap PLAY
wait 100
expect par68 0
expect knob2 Cutoff
expect stale 0
# a project saved before Stage: the first row
oldproject 12
reboot
wait 200
expect par68 0
