# Presets: 64 slots, all the init sound until saved. PRESETS picks one; SAVE, then SAVE again, saves the
# sound into one ("SAVE TO", PRESETS picks where); the rig's settings stay out of them.
wait 200
expect preset 1
expect edited 0
spin PRESET 63
expect preset 64
expect par0 15
expect par2 25
spin PRESET -63
expect preset 1
# a change: the sound is no longer its preset's
spin K1 30
expect par0 45
expect edited 1
wait 1400
shot edited.png
# SAVE, then anything else: not saved
tap SAVE
tap HOME
expect store_writes 0
expect edited 1
# SAVE, PRESETS to P03, SAVE: saved there, and the project follows it
tap SAVE
spin PRESET 2
wait 100
shot save_to.png
tap SAVE
expect preset 3
expect edited 0
expect store_writes 1
# P02 is still the init sound; the rig (Setup: transpose) stays as it is across presets
tap GLO
spin K1 5
expect par26 5
spin PRESET -1
expect preset 2
expect par0 15
expect par26 5
spin PRESET 1
expect preset 3
expect par0 45
expect par26 5
expect edited 0
# kept across a restart: the preset, its sound, and nothing changed
wait 5000
reboot
wait 200
expect preset 3
expect par0 45
expect edited 0
# SAVE held: the init sound, still on P03 (now changed from it)
press SAVE
wait 1600
release SAVE
tap SAVE
expect par0 15
expect preset 3
expect edited 1
spin PRESET -1
spin PRESET 1
expect par0 45
expect edited 0
# a project an older version saved (fewer values) comes back on its preset, its new values the defaults
spin PRESET 4
expect preset 7
tap FX
tap FX
tap FX
tap FX
expect view 15
spin K2 37
expect par34 40
oldproject 1
reboot
wait 200
expect preset 7
expect par34 3
oldproject 2
reboot
wait 200
expect preset 7
# 0.0.8 kept CC depth as a Glide value (50: 0.5 s); it comes back as 500 ms
tap LFO
tap LFO
spin K1 -350
expect par45 50
oldproject 4
reboot
wait 200
expect par45 500
# to 0.0.11, Glide was where the glide CC last left it; now it's the least glide time, so it comes back
# as 4 ms, the default
tap LFO
expect view 4
spin K2 196
expect par10 200
oldproject 6
reboot
wait 200
expect par10 4
# and 6 was Swarm (0.0.10, 0.0.11), since dropped: a sound saved on it comes back on Classic
spin ALGO 1
spin ALGO 1
spin ALGO 1
spin ALGO 1
spin ALGO 1
spin ALGO 1
expect par30 6
oldproject 6
reboot
wait 200
expect par30 0
# 0.0.13 (format 7) had no Distortion or Modulation: they come back at their defaults, the rest as saved
tap LFO
expect view 4
spin K2 196
expect par10 200
tap FX
expect view 12
spin K2 50
expect par49 50
oldproject 7
reboot
wait 200
expect par10 200
expect par49 0
expect par50 40
# 0.0.14 and 0.0.15 (format 8) had no noise layer: it comes back at its defaults, the effects as saved
tap FX
expect view 12
spin K2 50
expect par49 50
tap HOME
tap HOME
tap HOME
expect view 2
spin K1 30
expect par56 30
oldproject 8
reboot
wait 200
expect par49 50
expect par56 0
expect par58 24
