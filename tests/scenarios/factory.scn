# The factory presets: the first 17 slots, until something is saved over them. Each is the init sound's
# playing (breath to cutoff +75, attack, release, bend, glide) with its own tone; PRESETS shows its name.
wait 200
expect preset 1
expect edited 0
expect preset 1
expect edited 0
expect par30 0
expect par67 75
expect par6 5
expect par7 60
expect par8 2
expect par10 4
expect par11 0
expect par64 0
midi 90 3C 64
breath 0 100 100
wait 400
expect level >5
expect peak_db_max <-1
breath 100 0 50
midi 80 3C 0
wait 600
peakreset
spin PRESET 1
expect msg0 P02
expect msg1 Simple_Square
expect preset 2
