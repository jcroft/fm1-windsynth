# past them, the init sound, by number
spin PRESET 1
expect preset 18
expect msg0 PRESET
expect msg1 P18
expect par30 0
expect par2 25
expect par34 3
# Simple is exactly the init sound; Simple Square only its waveform
spin PRESET -17
expect msg1 Simple
expect par2 25
expect par0 15
expect par34 3
expect par41 0
spin PRESET 1
expect par2 50
expect par0 15
# Truth: VA's two saws (its AUX), 12 dB, Ping-pong delay into a hall
spin PRESET 4
expect msg1 Truth
expect par31 52
expect par32 0
expect par60 100
expect par3 0
expect par41 3
expect par33 1
# a sound saved over a factory preset keeps its slot's number, not its name
expect view 0
spin K1 10
expect edited 1
tap SAVE
tap SAVE
expect store_writes 1
expect preset 6
expect edited 0
spin PRESET 1
spin PRESET -1
expect msg0 PRESET
expect msg1 P06
expect par0 25
# ...and the others in its bank are still theirs, across a restart
spin PRESET 1
expect msg1 EWI_Doubler
wait 5000
reboot
wait 200
expect preset 7
expect par0 8
spin PRESET -1
expect par0 25
spin PRESET 2
expect msg1 Brecker_Rays
# a bank 0.0.20 saved held the init sound where nothing was saved: those slots take their factory presets,
# the saved one stays
wait 5000
oldbank 0
reboot
wait 200
expect preset 8
expect edited 0
expect par2 40
spin PRESET -2
expect preset 6
expect par0 25
expect par31 52
spin PRESET -4
expect msg1 Simple_Square
expect par2 50
# Slot 17, in the second bank, never saved: Air Pipe
spin PRESET 15
expect msg1 Air_Pipe
expect par30 7
expect par56 20
wait 50
expect stale 0
