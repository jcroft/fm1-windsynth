# Presets: 64 slots, the first 18 the factory presets (factory.scn), the rest the init sound until saved.
# PRESETS picks one; SAVE, then SAVE again, saves the
# sound into one ("SAVE TO", PRESETS picks where); the rig's settings stay out of them.
wait 200
expect preset 1
expect edited 0
spin PRESET 63
expect preset 64
expect par0 15
expect par2 25
spin PRESET -63
expect preset 1
# a change: the sound is no longer its preset's
spin K1 30
expect par0 45
expect edited 1
wait 1400
shot edited.png
# SAVE, then anything else: not saved
tap SAVE
tap HOME
expect store_writes 0
expect edited 1
# SAVE, PRESETS to P03, SAVE: saved there, and the project follows it
tap SAVE
spin PRESET 2
wait 100
shot save_to.png
tap SAVE
expect preset 3
expect edited 0
expect store_writes 1
# P02 is still its factory preset (Simple Square: the init cutoff); the rig (Pitch 2: transpose) stays as it is across presets
tap SEQ
tap SEQ
expect view 13
spin K2 5
expect par26 5
spin PRESET -1
expect preset 2
expect par0 15
expect par26 5
spin PRESET 1
expect preset 3
expect par0 45
expect par26 5
expect edited 0
# kept across a restart: the preset, its sound, and nothing changed
wait 5000
reboot
wait 200
expect preset 3
expect par0 45
expect edited 0
# SAVE held: the init sound, still on P03 (now changed from it)
press SAVE
wait 1600
release SAVE
tap SAVE
expect par0 15
expect preset 3
expect edited 1
spin PRESET -1
spin PRESET 1
expect par0 45
expect edited 0
# a project an older version saved (fewer values) comes back on its preset, its new values the defaults
spin PRESET 4
expect preset 7
tap FX
tap FX
tap FX
tap FX
expect view 19
spin K2 37
expect par34 40
oldproject 1
reboot
wait 200
expect preset 7
expect par34 3
oldproject 2
reboot
wait 200
expect preset 7
# 0.0.8 kept CC depth as a Glide value (50: 0.5 s); it comes back as 500 ms
tap SEQ
tap SEQ
spin K1 -350
expect par45 50
oldproject 4
reboot
wait 200
expect par45 500
# to 0.0.11, Glide was where the glide CC last left it; now it's the least glide time, so it comes back
# as 4 ms, the default
tap SEQ
expect view 12
spin K2 196
expect par10 200
oldproject 6
reboot
wait 200
expect par10 4
# and 6 was Swarm (0.0.10, 0.0.11), since dropped: a sound saved on it comes back on Classic
spin ALGO 1
spin ALGO 1
spin ALGO 1
spin ALGO 1
spin ALGO 1
spin ALGO 1
expect par30 6
oldproject 6
reboot
wait 200
expect par30 0
# 0.0.13 (format 7) had no Distortion or Modulation: they come back at their defaults, the rest as saved
tap SEQ
expect view 12
spin K2 196
expect par10 200
tap FX
expect view 16
spin K2 50
expect par49 50
oldproject 7
reboot
wait 200
expect par10 200
expect par49 0
expect par50 40
# 0.0.14 and 0.0.15 (format 8) had no noise layer: it comes back at its defaults, the effects as saved
tap FX
expect view 16
spin K2 50
expect par49 50
tap HOME
tap HOME
tap HOME
expect view 2
spin K1 30
expect par56 30
oldproject 8
reboot
wait 200
expect par49 50
expect par56 0
expect par58 24
# to 0.0.18 (format 11), breath reached the cutoff only through a Mod slot: the first slot sending it
# there gives the Filter page's Breath its amount and goes off, so the sound plays as it did
tap SEL
tap SEL
expect view 9
spin K1 1
spin K3 60
expect par15 1
expect par16 0
expect par17 60
oldproject 11
reboot
wait 200
expect par67 60
expect par15 0
expect par17 0
# an LFO on Pitch saved before the sample layer (format 15, and a bank of 70 values a preset): the
# Sample destination took Pitch's number, so it moves up to Pitch, in the project and in a preset
tap LFO
spin K3 -1
expect val3 Sample
expect par63 8
oldproject 15
reboot
wait 200
expect par63 9
tap LFO
spin K3 -1
expect par63 8
tap SAVE
tap SAVE
wait 50
expect par63 8
oldnpar 0 70
spin PRESET 1
spin PRESET -1
wait 50
expect par63 9
# (one saved with the sample layer keeps Sample)
spin K3 -1
tap SAVE
tap SAVE
wait 50
spin PRESET 1
spin PRESET -1
wait 50
expect par63 8
# nothing on the screen is stale
wait 50
expect stale 0
