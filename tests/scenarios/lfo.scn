# The LFO (LFO key): Shape, Rate (5 Hz to start), Dest and Amount, then Fade and Sync. Its own slot reaches
# what the Mod slots do, plus Pitch (Amount in cents). Harmonics is a destination where it moves smoothly
# (Formant, Waveshape, VA, Harmonic) and "Harm off" elsewhere; Aux is one for the Mod slots too.
wait 200
tap LFO
expect view 4
expect val3 Pitch
spin K4 50
expect par64 50
expect val4 +50c
tap LFO
expect view 5
spin K2 1
expect par66 1
expect val2 Note
shot lfo2_note.png
# Sync Note: the sine starts at 0 with the note, up first; a quarter cycle in, the pitch is 50 cents up
midi 90 3C 64
wait 50
expect note 6000
expect lfo >90
expect pitch >6040
wait 100
expect lfo <-90
expect pitch <5960
midi 80 3C 00
wait 200
# Fade 1 s: 50 ms into a note it is barely there
spin K1 1000
expect par65 1000
expect val1 1.0s
midi 90 3C 64
wait 50
expect lfo <10
expect lfo >-10
midi 80 3C 00
wait 200
spin K1 -1000
expect val1 Off
# Harmonics: off on Classic (it stays at the knob, 24), on VA it moves
tap LFO
expect view 4
spin K3 -2
expect par63 6
expect val3 Harm_off
midi 90 3C 64
wait 50
expect harm 24
midi 80 3C 00
wait 200
tap HOME
tap HOME
expect view 1
spin ALGO 1
spin ALGO 1
spin ALGO 1
spin ALGO 1
spin ALGO 1
expect par30 5
tap LFO
expect view 4
expect val3 Harmonics
midi 90 3C 64
wait 50
expect harm >70
wait 100
expect harm 0
midi 80 3C 00
wait 200
# Aux from a Mod slot: Mod 2, breath to Aux at 100
tap SEL
tap SEL
expect view 7
spin K1 1
spin K2 7
expect par16 7
expect val2 Aux
spin K3 100
midi 90 3C 64
breath 0 127 50
wait 30
expect aux 100
breath 127 0 50
wait 30
expect aux 0
midi 80 3C 00
wait 200
