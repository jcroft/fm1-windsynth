# Setup 2: the Speaker. Auto (the default) silences the FM-1's own output, its speaker and the jack,
# while a computer records over USB audio; On keeps it on. The page says which it is now.
wait 200
tap GLO
tap GLO
expect view 13
expect knob1 Speaker
expect val1 Auto
expect par69 0
wait 50
# not recording: on, nothing in the accent where it says so
expect count6_18_100_230_124 0
shot speaker_on.png
# changed while nothing records: the hint under it follows (the page redraws)
spin K1 1
expect val1 On
wait 50
expect stale 0
spin K1 -1
expect val1 Auto
wait 50
expect stale 0
usbrec 1
wait 50
# recording: "Silent", in the accent
expect count6_18_100_230_124 >20
expect stale 0
shot speaker_silent.png
spin K1 1
expect par69 1
expect val1 On
wait 50
expect count6_18_100_230_124 0
expect stale 0
# the rig's: kept across a reboot, and not in a preset (a preset changes the sound, not the speaker)
wait 5000
expect dirty 0
reboot
wait 200
expect par69 1
spin PRESET 1
wait 50
expect par69 1
# a project saved before the Speaker (0.0.30, format 14) comes back with it on Auto
oldproject 14
reboot
wait 200
expect par69 0
usbrec 0
