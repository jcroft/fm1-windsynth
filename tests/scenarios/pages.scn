# The pages: one button each (HOME: Voice and Engine, SEL: Mod 1-4, FX: Distortion, Modulation, Delay, Reverb and Reverb 2,
# pressed again), EDIT and SELECT step through all
wait 200
tap HOME
expect view 1
shot engine_page.png
tap HOME
expect view 0
tap ENV
expect view 2
shot breath_page.png
tap LFO
expect view 3
shot pitch_page.png
tap LFO
expect view 4
wait 50
shot pitch2_page.png
tap SEL
expect view 5
shot mod1_page.png
tap SEL
expect view 6
tap SEL
tap SEL
expect view 8
tap SEL
expect view 5
tap SEQ
expect view 9
tap GLO
expect view 10
shot setup_page.png
tap EDIT
expect view 11
tap FX
expect view 12
tap FX
expect view 13
tap FX
expect view 14
tap FX
expect view 15
tap FX
expect view 11
tap FX
tap FX
tap FX
tap FX
tap EDIT
expect view 0
turn SELECT 3
expect view 3
turn SELECT -4
expect view 15
tap HOME
expect view 0
