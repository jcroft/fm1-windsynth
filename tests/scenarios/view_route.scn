# The routing views: Mod 1-4 (the slot's cable and everything modulating now) and Setup (the tuner and
# the controller monitor), in both themes
wait 200
spin ALGO 1
spin ALGO 1
spin ALGO 1
spin ALGO 1
spin ALGO 1
expect par30 5
# (the engine's message gone from the header before the shots)
wait 1400
# Mod 1: Breath to the engine's Timbre (VA: Square), +40; the LFO on Morph (a square at its slowest: it
# holds still, so the screen does)
tap SEL
expect view 6
spin K1 1
spin K2 4
spin K3 40
expect par12 1
expect par13 4
expect par14 40
tap LFO
spin K1 3
spin K2 -100
spin K3 -5
expect par63 3
spin K4 40
tap SEL
expect view 6
midi 90 41 64
breath 0 85 60
wait 40
expect breath 67
expect timbre 67
shot mod1_light.png
expect stale 0
# the source's bar is accent up to its live level (67 % of 56 px from x 16), the track past it
expect themepx40_57 6
expect themepx66_57 2
# the destination's mark at its live value (67 % of 58 px from x 168), its knob's value blue under it
expect themepx207_52 6
expect themepx180_57 8
# the cable leaves the source in the accent, mixed into the panel by the breath: not the panel
expect themepx80_58 -1
# the live list: slot 1's row first, highlighted (the background), its level bar accent; the LFO's
# and the Filter's under it
expect themepx12_115 0
expect themepx170_118 6
expect themepx228_142 1
# full breath: the cable at full strength
breath 85 127 30
wait 30
expect themepx80_58 6
expect stale 0
breath 127 85 30
wait 30
# Dark (Setup's Theme)
tap GLO
spin K4 1
expect par29 1
tap SEL
expect view 6
wait 50
shot mod1_dark.png
expect stale 0
expect themepx40_57 6
expect themepx66_57 2
expect themepx12_115 0
# Mod 2: off, a grey cable; the list still shows slot 1, the LFO and the Filter, and "2-4 Off"
tap SEL
expect view 7
wait 30
shot mod2_off_dark.png
expect stale 0
expect themepx108_70 2
expect themepx80_58 2
tap GLO
spin K4 -1
expect par29 0
tap SEL
tap SEL
wait 30
shot mod2_off_light.png
expect stale 0
midi 80 41 00
breath 85 0 30
wait 200
# Setup: the tuner and the monitor
tap GLO
expect view 12
midi 90 41 64
breath 0 74 40
midi E0 00 38
wait 20
shot setup_light.png
expect stale 0
# F4 bitten down a quarter tone: -25c, the tuner's needle left of the middle in the accent
expect note 6475
expect themepx119_60 6
# the breath bar to 74/127 of 76 px from x 110, the track past it; its dot lit (just in)
expect themepx150_110 6
expect themepx170_110 2
expect themepx15_110 >-1
# the bite's bar from the middle (x 148) to the left
expect themepx145_126 8
wait 500
expect stale 0
# the dots go out, the values stay
expect themepx15_110 2
expect themepx150_110 6
spin K4 1
wait 50
shot setup_dark.png
expect stale 0
expect themepx150_110 6
expect themepx119_60 6
spin K4 -1
midi 80 41 00
wait 300
expect stale 0
# Mod 2 with all four slots on, the LFO and the Filter's Breath: six rows, the list taller (it starts
# 8 px higher: x 12, y 100 is the gap between the panels, not the slot's panel), slot 2's row lit
tap SEL
expect view 6
wait 30
expect themepx12_100 1
tap SEL
spin K1 2
spin K2 6
spin K3 -60
tap SEL
spin K1 3
spin K2 2
spin K3 20
tap SEL
spin K1 4
spin K2 7
spin K3 100
tap SEL
tap SEL
expect view 7
midi 90 41 64
breath 0 100 40
midi E0 00 20
wait 50
shot mod2_six_light.png
expect stale 0
expect themepx12_100 0
expect themepx12_120 0
expect themepx170_121 6
tap GLO
spin K4 1
tap SEL
tap SEL
wait 50
shot mod2_six_dark.png
expect stale 0
expect themepx12_100 0
expect themepx12_120 0
midi 80 41 00
wait 300
expect stale 0
